# Copy to .env.local. Never commit real values. All values are server-only (never NEXT_PUBLIC_).
# The app runs with the rule-based planner when AI is disabled.
AI_ENABLED=false
# Optional: gemini or groq. When empty, Gemini is used if both GEMINI_* values are set,
# otherwise Groq. Only the selected provider is called.
AI_PROVIDER=
# Gemini key from https://aistudio.google.com/apikey and a model id verified to support
# function calling.
GEMINI_API_KEY=
GEMINI_MODEL=
# Groq key from https://console.groq.com/keys and a model id verified to support tool calling.
GROQ_API_KEY=
GROQ_MODEL=
