# Copy to .env.local. Never commit real values.
# Get a Groq API key at https://console.groq.com/keys (server-only, never NEXT_PUBLIC_).
# The app runs with the rule-based planner when AI is disabled.
AI_ENABLED=false
GROQ_API_KEY=
# A Groq model id verified to support tool calling. The agent runs only when
# AI_ENABLED=true and both GROQ_* values are set.
GROQ_MODEL=
